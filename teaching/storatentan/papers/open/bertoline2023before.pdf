<rdf:Description rdf:about="">
<dc:identifier></dc:identifier>
<dc:title>Before and after AlphaFold2: An overview of protein structure prediction</dc:title>
<prism:doi></prism:doi>
<prism:url></prism:url>
<dc:creator><rdf:Bag><rdf:li>Letícia M. F. Bertoline</rdf:li>
<rdf:li>Angélica N. Lima</rdf:li>
<rdf:li>Jose E. Krieger</rdf:li>
<rdf:li>Samantha K. Teixeira</rdf:li>
</rdf:Bag></dc:creator>
<dc:description>Three-dimensional protein structure is directly correlated with its function and its determination is critical to understanding biological processes and addressing human health and life science problems in general.</dc:description>
<dc:subject><rdf:Bag><rdf:li>protein structure prediction</rdf:li><rdf:li>AlphaFold</rdf:li><rdf:li>template-based modeling</rdf:li><rdf:li>free modeling</rdf:li><rdf:li>protein language model</rdf:li></rdf:Bag></dc:subject>
